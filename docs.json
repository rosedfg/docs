{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Matrix Network",
  "description": "Документация VPN-сервиса Matrix Network",
  "colors": {
    "primary": "#111111",
    "light": "#FAFAFA",
    "dark": "#111111"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://matrixnetwork.top"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Начало",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Подключение",
        "pages": [
          "connect/windows",
          "connect/macos",
          "connect/linux",
          "connect/android",
          "connect/ios"
        ]
      },
      {
        "group": "Аккаунт",
        "pages": ["account/subscription", "account/devices"]
      },
      {
        "group": "Помощь",
        "pages": ["troubleshooting", "faq"]
      }
    ]
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/"
    }
  },
  "search": {
    "prompt": "Поиск по документации"
  }
}
