        "pages": [
          "networks/alpha",
          "networks/beta",
          "networks/gaming"
        ]
      },
      {
        "group": "Подписка",
        "pages": [
          "account/pricing",
          "account/trial",
          "account/cabinet",
          "account/referral"
        ]
