  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Начало",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Подключение",
        "pages": [
          "connect/apps",
          "connect/android",
          "connect/ios",
          "connect/windows",
          "connect/macos",
          "connect/linux",
          "connect/android-tv",
          "connect/router"
        ]
      },
      {
        "group": "Сети",
        "pages": [
          "networks/alpha",
          "networks/beta",
          "networks/gaming"
        ]
      },
      {
        "group": "Подписка",
        "pages": [
          "account/pricing",
          "account/trial",
          "account/cabinet",
          "account/referral"
        ]
      },
      {
        "group": "Помощь",
        "pages": [
          "troubleshooting",
          "faq"
        ]
      },
      {
        "group": "Полезные советы",
        "pages": [
          "programmy-i-igry-bez-vpn"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/thematrixvpn"
    }
  },
  "search": {
    "prompt": "Поиск по документации"
