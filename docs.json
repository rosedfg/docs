    "primary": "#00FF41",
    "light": "#00FF41",
    "dark": "#00C832"
  },
  "background": {
    "color": {
      "light": "#020603",
      "dark": "#020603"
    }
  },
  "fonts": {
    "family": "JetBrains Mono"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "logo": {
    "light": "/logo/light.svg",
