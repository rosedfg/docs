      {
        "label": "Поддержка",
        "href": "https://t.me/thematrixvpn?direct"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Открыть бота",
      "href": "https://t.me/matrix402bot"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "The Matrix [VPN]",
      "og:image": "https://matrixnetwork.top/docs/images/og.jpg",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:locale": "ru_RU",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://matrixnetwork.top/docs/images/og.jpg"
    }
  }
